{
  "name": "benchhand",
  "version": "0.0.0-dev",
  "description": "A durable, cross-platform development MCP platform.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "quality": "npm run check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
